# ─── Database (PostgreSQL 14+) ───────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/greenhouse

# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Dashboard origin(s), comma separated. Needed for CORS with cookies.
FRONTEND_URL=http://localhost:3000
# Behind a reverse proxy / PaaS set to 1 so rate limiting sees real client IPs
# TRUST_PROXY=1

# ─── Dashboard login (JWT) ───────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
REFRESH_TOKEN_SECRET=change-me-too
ACCESS_TOKEN_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=30d
# Cross-site dashboard (different domain than the API) over HTTPS:
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.example.com
# Local-network-only setups can switch the login off (NOT for internet-facing servers):
# DASHBOARD_AUTH_REQUIRED=false

# ─── First-run seed (npm run seed) ───────────────────────────
ADMIN_EMAIL=admin@greenhouse.local
# Leave empty to get a random password printed once
ADMIN_PASSWORD=
DEVICE_NAME=Greenhouse-1
# Optional: choose the hardware key yourself (must start with ghk_ and be long & random). Empty = generated and printed once.
DEVICE_API_KEY=

# ─── Tuning ──────────────────────────────────────────────────
# DEVICE_RATE_LIMIT_PER_MIN=120
# JOBS_ENABLED=true      # offline watchdog + data retention; set false on serverless hosts
